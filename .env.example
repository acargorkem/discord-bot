# Discord Developer Portal > Applications > (uygulaman) > Bot > Reset Token
DISCORD_TOKEN=

# Applications > (uygulaman) > General Information > Application ID
DISCORD_CLIENT_ID=

# Test sunucunun ID'si.
# Discord'da: Ayarlar > Gelişmiş > Geliştirici Modu'nu aç,
# sonra sunucuya sağ tık > "Sunucu Kimliğini Kopyala"
GUILD_ID=

# --- NodeLink (ses sunucusu) — İSTEĞE BAĞLI (yerel, Docker'sız çalıştırma) ---
# Boş bırakılırsa varsayılanlar kullanılır (localhost:4000).
# LAVALINK_HOST=localhost
# LAVALINK_PORT=4000
# LAVALINK_PASSWORD=youshallnotpass

# --- Docker / VPS — İSTEĞE BAĞLI ---
# NodeLink şifresi (bot ve NodeLink konteynerleri bunu paylaşır). İç ağda kalır.
# NODELINK_PASSWORD=youshallnotpass
# CI'nin ittiği imaj (VPS'te bu satırı doldur; yerelde boş bırak, imaj derlenir).
# BOT_IMAGE=ghcr.io/<kullanici-adin>/<repo-adi>:latest
# Sağlık sunucusu portu (Docker healthcheck; dışarı açılmaz). Varsayılan 3000.
# HEALTH_PORT=3000
# Log seviyesi (trace|debug|info|warn|error). Varsayılan info.
# LOG_LEVEL=info
# SQLite veritabanı yolu. Varsayılan ./data/bot.db (Docker'da /app/data/bot.db).
# DB_PATH=./data/bot.db

# --- YouTube OAuth (datacenter IP throttling'i aşmak için) — İSTEĞE BAĞLI ---
# Ayrıntılı adımlar: docs/YOUTUBE_OAUTH.md
# İlk kurulumda true yapıp NodeLink loglarından device-login ile giriş yap,
# çıkan refresh token'ı aşağıya koy, sonra bunu tekrar false yap.
# NODELINK_YT_OAUTH=false
# Device-login sonrası loglardan alınan refresh token (SECRET — commit'leme!).
# Birden fazla token'ı virgülle ekleyebilirsin (yedek/rotasyon).
# NODELINK_YT_REFRESH_TOKEN=
# YouTube bu IP'den bloklanıyorsa komple kapat (Spotify vb. soundcloud/deezer'dan çalar).
# NODELINK_YT_ENABLED=false
# YouTube'u kapatırsan arama kaynaklarını da youtube'suz yap (yoksa NodeLink çöker).
# NODELINK_SEARCH_SOURCES=soundcloud

# --- Web Paneli (Discord OAuth2) — yalnızca panel kullanılırsa ---
# Applications > (uygulaman) > OAuth2 > Client Secret
# DISCORD_CLIENT_SECRET=
# OAuth2 redirect URI (Discord portalına da eklenmeli). Üretimde https + domain.
# OAUTH_REDIRECT_URI=https://panel.example.com/api/auth/callback
# Panele girebilecek Discord kullanıcı ID'leri (virgülle ayrılmış).
# PANEL_ALLOWED_USER_IDS=123456789012345678
# Üretimde (HTTPS) true olmalı; yerelde http için false.
# PANEL_COOKIE_SECURE=true
# Panelin herkese açık origin'i (CSRF kontrolü için). Üretimde https + domain.
# PANEL_ORIGIN=https://panel.example.com
# Panelin domain'i (Caddy otomatik HTTPS için). VPS IP'sine A kaydı olmalı.
# PANEL_DOMAIN=panel.example.com
# CI'nin ittiği web (Caddy) imajı — VPS'te doldur, yerelde boş bırak (derlenir).
# WEB_IMAGE=ghcr.io/<kullanici-adin>/<repo-adi>-web:latest
